{
 "entra_apps_deep_dive": {
  "recipe": "entra-apps-deep-dive",
  "version": "0.2.0",
  "params": [
   "tenantId",
   "asOf"
  ],
  "note": "Every value in the report comes from one of these calls, run exactly as written with the params filled in. Lists are read at most 100 rows a page and every page is saved; the build fails if a list was cut short. Microsoft-published: appOwnerOrganizationId is one of the seven Microsoft tenant ids in references/app-classification-convention.md; the grammar has no notIn, so the lists AND seven ne filters, which keep apps with no appOwnerOrganizationId. Application permissions come from each API's appRoleAssignedTo, because an app's own appRoleAssignments list stops at 20 (I365-562) and its stored permissionValue labels are unreliable. Secure Score controls in scope: App Governance (AppG) and Defender for Cloud Apps (MCAS), plus the Entra ID controls IntegratedApps, aad_admin_consent_workflow and aad_third_party_apps. Single ingest: every date is one Microsoft returns on the object (createdDateTime on the service principal and on each app role assignment, credential start and end dates) or in its sign-in activity report (lastSignInDateTime). lastConsentDateTime is not read: the Collector takes it from audit log consent events in the 30 days before a run, and Entra keeps 7 days of audit log without P1 or P2.",
  "queries": [
   {
    "id": "sp_by_type",
    "tool": "aggregate",
    "entity": "service-principals",
    "groupBy": "servicePrincipalType",
    "maxBuckets": 71
   },
   {
    "id": "sp_microsoft_by_tenant",
    "tool": "aggregate",
    "entity": "service-principals",
    "groupBy": "appOwnerOrganizationId",
    "maxBuckets": 72,
    "filters": [
     {
      "field": "appOwnerOrganizationId",
      "operator": "in",
      "value": [
       "f8cdef31-a31e-4b4a-93e4-5f571e91255a",
       "72f988bf-86f1-41af-91ab-2d7cd011db47",
       "cdc5aeea-15c5-4db6-b079-fcadd2505dc2",
       "33e01921-4d64-4f8c-a055-5bdaffd5e33d",
       "0d933fb8-3f65-4722-9430-08d60fc88af4",
       "975f013f-7f24-47e8-a7d3-abc4752bf346",
       "47df5bb7-e6bc-4256-afb0-dd8c8e3c1ce8"
      ]
     }
    ]
   },
   {
    "id": "microsoft_with_roles",
    "tool": "aggregate",
    "entity": "service-principals",
    "groupBy": "directoryRoles[].displayName",
    "maxBuckets": 73,
    "filters": [
     {
      "field": "appOwnerOrganizationId",
      "operator": "in",
      "value": [
       "f8cdef31-a31e-4b4a-93e4-5f571e91255a",
       "72f988bf-86f1-41af-91ab-2d7cd011db47",
       "cdc5aeea-15c5-4db6-b079-fcadd2505dc2",
       "33e01921-4d64-4f8c-a055-5bdaffd5e33d",
       "0d933fb8-3f65-4722-9430-08d60fc88af4",
       "975f013f-7f24-47e8-a7d3-abc4752bf346",
       "47df5bb7-e6bc-4256-afb0-dd8c8e3c1ce8"
      ]
     },
     {
      "field": "directoryRoles[].displayName",
      "operator": "isNotNull"
     }
    ]
   },
   {
    "id": "apps",
    "tool": "query",
    "entity": "service-principals",
    "maxResults": 100,
    "fields": [
     "id",
     "displayName",
     "appOwnerOrganizationId",

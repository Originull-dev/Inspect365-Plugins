{
 "tenant_overview": {
  "recipe": "tenant-overview",
  "version": "0.2.0",
  "params": [
   "tenantId",
   "asOf"
  ],
  "note": "Every value in the report comes from one of these calls, run exactly as written with the params filled in. Everything works from one collection run, as on a prospect's first pull: aggregates, the latest Microsoft Secure Score snapshot (secure_score, no filter), the Secure Score recommended actions below their maximum points, and three lists for the high-impact section. A list longer than its maxResults is paged with pageToken and saved as one input; the build fails if a list was cut short. maxBuckets and maxResults values are unique per call so the echo in each response identifies it.",
  "queries": [
   {
    "id": "findings_open_by_type",
    "tool": "aggregate",
    "entity": "findings",
    "groupBy": "type",
    "maxBuckets": 51,
    "filters": [
     {
      "field": "latestStatusName",
      "operator": "in",
      "value": [
       "Needs Review",
       "Flagged"
      ]
     }
    ]
   },
   {
    "id": "findings_accepted_by_type",
    "tool": "aggregate",
    "entity": "findings",
    "groupBy": "type",
    "maxBuckets": 52,
    "filters": [
     {
      "field": "latestStatusName",
      "operator": "eq",
      "value": "Accepted"
     }
    ]
   },
   {
    "id": "findings_open_by_check",
    "tool": "aggregate",
    "entity": "findings",
    "groupBy": "findingId",
    "maxBuckets": 99,
    "filters": [
     {
      "field": "latestStatusName",
      "operator": "in",
      "value": [
       "Needs Review",
       "Flagged"
      ]
     }
    ]
   },
   {
    "id": "definitions",
    "tool": "list_finding_definitions",
    "detail": true
   },
   {
    "id": "secure_score",
    "tool": "query",
    "entity": "secure-score",
    "maxResults": 68
   },
   {
    "id": "controls_below_max_by_category",
    "tool": "aggregate",
    "entity": "secure-scores",
    "groupBy": "controlCategory",
    "maxBuckets": 65,
    "filters": [
     {
      "field": "deprecated",
      "operator": "eq",
      "value": false
     },
     {
      "field": "controlScore.scoreInPercentage",
      "operator": "lt",
      "value": 100
     }
    ]
   },
   {
    "id": "controls_scored_by_category",
    "tool": "aggregate",
    "entity": "secure-scores",
    "groupBy": "controlCategory",
    "maxBuckets": 66,
    "filters": [
     {
      "field": "deprecated",
      "operator": "eq",
      "value": false
     },
     {
      "field": "controlScore.scoreInPercentage",
      "operator": "isNotNull"
     }
    ]
   },
   {
    "id": "secure_score_actions",
    "tool": "query",
    "entity": "secure-scores",
    "maxResults": 94,
    "fields": [
     "id",
     "title",
     "service",
     "controlCategory",
     "maxScore",
     "controlScore.score",
     "rank",
     "controlScore.implementationStatus",
     "controlStateUpdates[].state",
     "controlStateUpdates[].updatedDateTime"
    ],
    "filters": [
     {
      "field": "deprecated",
      "operator": "eq",
      "value": false
     },
     {
      "field": "controlScore.scoreInPercentage",
      "operator": "lt",
      "value": 100
     }
    ]
   },
   {
    "id": "users_by_type",
    "tool": "aggregate",
    "entity": "users",
    "groupBy": "userType",
    "maxBuckets": 53
   },
   {
    "id": "members_by_enabled",
    "tool": "aggregate",

   },
   {
    "id": "critical_software",
    "tool": "query",
    "entity": "defender-applications",
    "maxResults": 71,
    "fields": [
     "id",
     "softwareName",
     "softwareVersion",
     "devices[].coreDeviceId"
    ],
    "filters": [
